{
  "name": "flowboard",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n db,api,web -c blue,green,magenta \"npm run db -w server\" \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "type": "module"
}
